{
  "name": "x-buddy",
  "version": "0.1.0",
  "description": "Standalone x-buddy foundation; product integration pending",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerry-Xin/x-buddy.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-timeout=30000 \"test/*.test.mjs\" \"test/foundation/**/*.test.mjs\" \"test/app-server/**/*.test.mjs\" \"test/runtime/**/*.test.mjs\"",
    "test:foundation": "node --test \"test/foundation/**/*.test.mjs\"",
    "test:app-server": "npm run build && node --test --test-timeout=30000 \"test/app-server/**/*.test.mjs\"",
    "test:host": "vitest run --config vitest.config.mjs",
    "test:goldens": "node test/foundation/tools/check-goldens.mjs",
    "test:parity-matrix": "node test/foundation/parity/validate-parity-matrix.mjs",
    "build": "tsc",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "check:native": "node scripts/check-native.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:foundation-scope": "node test/foundation/tools/check-scope.mjs --base",
    "check": "npm run typecheck && npm run lint && npm run check:tests && npm test && npm run test:host && npm run check:native && npm run test:goldens && npm run test:parity-matrix && npm run build && npm run pack-smoke && npm run check:imports && npm run check:security"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.142.3",
    "better-sqlite3": "12.11.1",
    "crypto-js": "4.2.0",
    "curve25519-js": "0.0.4",
    "md5-typescript": "1.0.5",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/crypto-js": "4.2.2",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.6"
  }
}
